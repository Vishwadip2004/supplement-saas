# Database (Neon, Supabase, or any PostgreSQL provider)
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/supplement_saas"

# Authentication (generate with: openssl rand -base64 32)
# Must match NEXTAUTH_URL in production
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Encryption (generate with: openssl rand -base64 32)
ENCRYPTION_KEY="your-super-secret-encryption-key-change-in-production"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
