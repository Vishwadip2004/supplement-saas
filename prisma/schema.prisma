generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  UPI
  OTHER
}

enum AuditStatus {
  SUCCESS
  FAILURE
  WARNING
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

enum RecallStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Tenant {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]
  products      Product[]
  customers     Customer[]
  suppliers     Supplier[]
  sales         Sale[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  auditLogs     AuditLog[]
  bundles       Bundle[]
  recalls       Recall[]
  lots          Lot[]
  categories    Category[]

  @@map("tenants")
}

model Category {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  emoji         String    @default("📦")
  color         String    @default("gray")
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model User {
  id            String    @id @default(uuid())
  tenantId      String
  email         String
  name          String
  password      String    // Hashed password
  role          Role      @default(STAFF)
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  lastLogin     DateTime?
  failedLoginAttempts Int @default(0)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tokenVersion  Int       @default(0)

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]
  sessions      Session[]
  passwordHistory PasswordHistory[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Product {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  sku           String
  barcode       String?
  description   String?
  category      String
  brand         String
  flavor        String?
  size          String?
  purchasePrice Decimal   @db.Decimal(10, 2)
  sellingPrice  Decimal   @db.Decimal(10, 2)
  hsnCode       String?
  gstRate       Decimal   @default(18) @db.Decimal(5, 2)
  quantity      Int       @default(0)
  minStock      Int       @default(10)
  reorderLevel  Int?
  expiryDate    DateTime?
  batchNumber   String?
  storageLocation String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales         Sale[]
  stockMovements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  bundleItems   BundleItem[]
  bundleComponents BundleComponent[]
  lots          Lot[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("products")
}

model Customer {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  address       String?
  gstin         String?
  state         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales         Sale[]

  @@index([tenantId])
  @@map("customers")
}

model Supplier {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  leadTimeDays  Int?
  qualityRating Decimal?  @db.Decimal(3, 2)
  onTimeRate    Decimal?  @db.Decimal(5, 2)
  totalOrders   Int       @default(0)
  onTimeOrders  Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

model Sale {
  id            String    @id @default(uuid())
  tenantId      String
  productId     String
  customerId    String?
  invoiceNumber String?
  quantity      Int
  unitPrice     Decimal   @db.Decimal(10, 2)
  discount      Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(10, 2)
  cgst          Decimal   @default(0) @db.Decimal(10, 2)
  sgst          Decimal   @default(0) @db.Decimal(10, 2)
  igst          Decimal   @default(0) @db.Decimal(10, 2)
  totalTax      Decimal   @default(0) @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  customerName  String?
  notes         String?
  lotNumber     String?
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer      Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([lotNumber])
  @@map("sales")
}

model StockMovement {
  id            String    @id @default(uuid())
  tenantId      String
  productId     String
  quantity      Int
  type          StockMovementType
  reference     String?
  notes         String?
  lotNumber     String?
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([lotNumber])
  @@map("stock_movements")
}

model PurchaseOrder {
  id            String    @id @default(uuid())
  tenantId      String
  supplierId    String
  status        PurchaseOrderStatus @default(PENDING)
  totalAmount   Decimal   @db.Decimal(10, 2)
  expectedDeliveryDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]

  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String    @id @default(uuid())
  purchaseOrderId String
  productId     String
  quantity      Int
  unitPrice     Decimal   @db.Decimal(10, 2)
  landedCost    Decimal?  @db.Decimal(10, 2)
  lotNumber     String?
  expiryDate    DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
}

model AuditLog {
  id            String    @id @default(uuid())
  tenantId      String
  userId        String?
  action        String
  resource      String
  resourceId    String?
  details       String?   // JSON string
  ipAddress     String?
  userAgent     String?
  status        AuditStatus
  timestamp     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}

model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  password  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

model SystemConfig {
  id            String    @id @default(uuid())
  key           String    @unique
  value         String
  description   String?
  updatedAt     DateTime  @updatedAt

  @@map("system_config")
}

model Bundle {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  bundlePrice   Decimal   @db.Decimal(10, 2)
  discount      Decimal   @default(0) @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         BundleItem[]
  components    BundleComponent[]

  @@index([tenantId])
  @@map("bundles")
}

model BundleItem {
  id            String    @id @default(uuid())
  bundleId      String
  productId     String
  quantity      Int       @default(1)

  bundle        Bundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])

  @@map("bundle_items")
}

model BundleComponent {
  id            String    @id @default(uuid())
  bundleId      String
  productId     String
  quantity      Int       @default(1)

  bundle        Bundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])

  @@map("bundle_components")
}

model Recall {
  id            String    @id @default(uuid())
  tenantId      String
  batchNumber   String
  productName   String
  reason        String
  status        RecallStatus @default(ACTIVE)
  affectedQuantity Int
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([batchNumber])
  @@map("recalls")
}

model Lot {
  id            String    @id @default(uuid())
  tenantId      String
  productId     String
  batchNumber   String
  expiryDate    DateTime?
  quantity      Int       @default(0)
  purchasePrice Decimal?  @db.Decimal(10, 2)
  landedCost    Decimal?  @db.Decimal(10, 2)
  coaUrl        String?
  coaNotes      String?
  receivedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId])
  @@index([productId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@map("lots")
}
